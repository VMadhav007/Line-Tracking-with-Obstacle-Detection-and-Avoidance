<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="line_track_world">

    <!-- === PHYSICS === -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- === LIGHTING === -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Additional overhead light for better camera visibility -->
    <light name="overhead_light" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <!-- === WHITE GROUND PLANE === -->
    <model name="white_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- === LINE TRACK (oval loop) === -->
    <include>
      <uri>model://line_track</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- === OBSTACLE 1: On the top straight segment === -->
    <include>
      <uri>model://obstacle_box</uri>
      <name>obstacle_1</name>
      <pose>0.5 1.0 0.1 0 0 0</pose>
    </include>

    <!-- === OBSTACLE 2: On the bottom straight segment === -->
    <include>
      <uri>model://obstacle_box</uri>
      <name>obstacle_2</name>
      <pose>-0.5 -1.0 0.1 0 0 0</pose>
    </include>

    <!-- === SCENE SETTINGS === -->
    <scene>
      <shadows>false</shadows>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
    </scene>

    <!-- === GUI CAMERA === -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0 -5 8 0 0.9 1.57</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>
