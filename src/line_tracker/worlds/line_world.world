<?xml version="1.0"?>
<sdf version="1.6">
  <world name="line_world">

    <!-- ── Lighting ─────────────────────────────────────────────── -->
    <include><uri>model://sun</uri></include>

    <!-- ── Physics ──────────────────────────────────────────────── -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- ── White ground plane ────────────────────────────────────── -->
    <model name="white_floor">
      <static>true</static>
      <pose>0 0 -0.001 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>12 12 0.002</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>12 12 0.002</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Black line: oval / elongated circuit ───────────────────
         The "line" is a series of thin black boxes that together
         form a closed oval about 5 m × 2.5 m.
         Robot starts at (0,0) facing +X.
    ─────────────────────────────────────────────────────────────── -->

    <!-- Straight section — going right (+X) -->
    <model name="line_top">
      <static>true</static>
      <pose>0 1.25 0.001 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>4.0 0.06 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Straight section — going left (-X) -->
    <model name="line_bottom">
      <static>true</static>
      <pose>0 -1.25 0.001 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>4.0 0.06 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Right semicircle: approximate with 8 short segments -->
    <model name="line_rc0"><static>true</static>
      <pose>2.0  1.087 0.001 0 0 -0.3927</pose>
      <link name="link"><visual name="vis"><geometry><box><size>0.64 0.06 0.001</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link></model>

    <model name="line_rc1"><static>true</static>
      <pose>2.471 0.75 0.001 0 0 -0.7854</pose>
      <link name="link"><visual name="vis"><geometry><box><size>0.64 0.06 0.001</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link></model>

    <model name="line_rc2"><static>true</static>
      <pose>2.75 0.293 0.001 0 0 -1.1781</pose>
      <link name="link"><visual name="vis"><geometry><box><size>0.64 0.06 0.001</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link></model>

    <model name="line_rc3"><static>true</static>
      <pose>2.75 -0.293 0.001 0 0 1.1781</pose>
      <link name="link"><visual name="vis"><geometry><box><size>0.64 0.06 0.001</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link></model>

    <model name="line_rc4"><static>true</static>
      <pose>2.471 -0.75 0.001 0 0 0.7854</pose>
      <link name="link"><visual name="vis"><geometry><box><size>0.64 0.06 0.001</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link></model>

    <model name="line_rc5"><static>true</static>
      <pose>2.0 -1.087 0.001 0 0 0.3927</pose>
      <link name="link"><visual name="vis"><geometry><box><size>0.64 0.06 0.001</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link></model>

    <!-- Left semicircle -->
    <model name="line_lc0"><static>true</static>
      <pose>-2.0  1.087 0.001 0 0  0.3927</pose>
      <link name="link"><visual name="vis"><geometry><box><size>0.64 0.06 0.001</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link></model>

    <model name="line_lc1"><static>true</static>
      <pose>-2.471 0.75 0.001 0 0  0.7854</pose>
      <link name="link"><visual name="vis"><geometry><box><size>0.64 0.06 0.001</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link></model>

    <model name="line_lc2"><static>true</static>
      <pose>-2.75 0.293 0.001 0 0  1.1781</pose>
      <link name="link"><visual name="vis"><geometry><box><size>0.64 0.06 0.001</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link></model>

    <model name="line_lc3"><static>true</static>
      <pose>-2.75 -0.293 0.001 0 0 -1.1781</pose>
      <link name="link"><visual name="vis"><geometry><box><size>0.64 0.06 0.001</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link></model>

    <model name="line_lc4"><static>true</static>
      <pose>-2.471 -0.75 0.001 0 0 -0.7854</pose>
      <link name="link"><visual name="vis"><geometry><box><size>0.64 0.06 0.001</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link></model>

    <model name="line_lc5"><static>true</static>
      <pose>-2.0 -1.087 0.001 0 0 -0.3927</pose>
      <link name="link"><visual name="vis"><geometry><box><size>0.64 0.06 0.001</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link></model>

    <!-- ── Obstacle 1 — on the top straight ─────────────────────── -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>1.0 1.25 0.15 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.2 0.2 0.3</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 0.2 0.3</size></box></geometry>
          <material><ambient>1 0.3 0 1</ambient><diffuse>1 0.3 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Obstacle 2 — on the bottom straight ───────────────────── -->
    <model name="obstacle_2">
      <static>true</static>
      <pose>-1.0 -1.25 0.15 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.2 0.2 0.3</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 0.2 0.3</size></box></geometry>
          <material><ambient>0.8 0 0.8 1</ambient><diffuse>0.8 0 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
